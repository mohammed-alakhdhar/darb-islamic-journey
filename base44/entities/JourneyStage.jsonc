{
  "name": "JourneyStage",
  "type": "object",
  "properties": {
    "journey_slug": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 1
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "narrative": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "xp_reward": {
      "type": "number",
      "default": 100
    },
    "badge_name": {
      "type": "string"
    },
    "unlock_after": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "journey_slug",
    "order",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}